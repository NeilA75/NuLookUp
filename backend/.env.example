# NuLookUp backend environment example
# Copy this file to `.env` in the same folder and fill in real API keys.
# Restart the backend after creating/updating `.env`.

# ─── REQUIRED FOR BASIC FUNCTIONALITY ───

# OpenAI (enables AI summaries)
OPENAI_API_KEY=

# NewsAPI (enables related news fetch)
NEWS_API_KEY=

# Alpha Vantage (enables stock, commodity prices)
ALPHA_VANTAGE_KEY=

# Fixer (enables forex prices)
FIXER_API_KEY=

# Backend server port (default 3000)
PORT=3000

# ─── OPTIONAL: FUTURE API INTEGRATIONS ───
# Uncomment and add keys to unlock premium features

# KEEPA_API_KEY=
# ZILLOW_API_KEY=
# AMAZON_PA_KEY=
# ETSY_API_KEY=
# EBAY_API_KEY=
# BLS_API_KEY=

# ─── NOTES ───
# All APIs are optional except where noted
# Backend uses web scraping as fallback if APIs unavailable
# Price data accuracy depends on API key availability
# - Create a file named `.env` (without extension) with the real values.
# - Example on Windows (PowerShell):
#     Set-Content -Path .env -Value "OPENAI_API_KEY=sk_...`nNEWS_API_KEY=...`nPORT=3001"
# - Restart the backend after editing:
#     cd backend
#     npm run dev
