# NuLookUp backend environment example
# Copy this file to `.env` in the same folder and fill in real API keys.
# Restart the backend after creating/updating `.env`.

# OpenAI (optional, enables AI summaries)
OPENAI_API_KEY=

# NewsAPI (optional, enables related news fetch)
NEWS_API_KEY=

# Alpha Vantage (optional, monthly stock series)
ALPHA_VANTAGE_KEY=

# Backend server port (default 3000)
PORT=3000

# Notes:
# - Create a file named `.env` (without extension) with the real values.
# - Example on Windows (PowerShell):
#     Set-Content -Path .env -Value "OPENAI_API_KEY=sk_...`nNEWS_API_KEY=...`nPORT=3000"
# - Or create the file in your editor and restart the backend:
#     cd backend
#     npm run dev
